#!/bin/bash
# AppRun for the gitbox AppImage. build-appimage.sh installs it in place of
# the one linuxdeploy generates, so it has to do what that one did (source the
# GTK plugin hook) plus one gitbox-specific thing:
#
# - run from AppDir/usr: build-appimage.sh patches the bundled WebKitGTK so
#   its compiled-in "/usr/..." paths become "././..." and it finds its
#   helper processes (WebKitWebProcess, WebKitNetworkProcess,
#   WebKitGPUProcess) under AppDir/usr instead of the host's /usr
set -e
this_dir="$(readlink -f "$(dirname "$0")")"
export APPDIR="$this_dir"
for hook in "$this_dir"/apprun-hooks/*; do
  # shellcheck disable=SC1090
  source "$hook"
done
cd "$this_dir/usr"
exec "$this_dir/usr/bin/GitboxApp" "$@"
