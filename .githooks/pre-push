#!/usr/bin/env bash
# Pre-push hook: the local gate's enforcement point.
#
# - A push that updates main needs a scripts/gate.sh marker for the pushed
#   commit. A "partial" marker (a lane was skipped) passes only with
#   GATE_ALLOW_PARTIAL=1. No marker blocks the push.
# - Other branches: a commit with a gate marker skips the checks below;
#   otherwise the hook runs a gofmt check, go vet and unit tests, building
#   the GUI frontend first when cmd/gui/frontend/dist is missing.
# - Tag-only pushes and branch deletions skip every check.
#
# Setup (one time):
#   git config core.hooksPath .githooks

set -e

# Git exports GIT_DIR (absolute when pushing from a linked worktree),
# GIT_WORK_TREE and friends to hooks. Every git call the test suite makes
# would then target THIS repository instead of the tests' temp repos — a
# single `git init --bare` in a test is enough to flip the main clone to
# core.bare=true. Scrub them so tests run against a clean environment.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY

# Gate markers live in the git common dir, shared by every worktree.
marker_dir="$(git rev-parse --path-format=absolute --git-common-dir)/gitbox-gate"
zero="0000000000000000000000000000000000000000"

# gate_status <sha>: prints pass, partial or nothing.
gate_status() {
    [ -f "$marker_dir/$1" ] && sed -n 's/^status=//p' "$marker_dir/$1"
}

# Git passes "<local ref> <local sha> <remote ref> <remote sha>" per ref on
# stdin. Read every line: main needs a gate marker; other branch commits
# without a marker need the light checks.
need_checks=false
blocked=false
while read -r local_ref local_sha remote_ref _; do
    case "$local_ref" in refs/tags/*) continue ;; esac
    [ "$local_sha" = "$zero" ] && continue   # branch deletion
    status="$(gate_status "$local_sha")"
    if [ "$remote_ref" = "refs/heads/main" ]; then
        case "$status" in
            pass) echo "pre-push: main ← ${local_sha:0:12}: gate passed" ;;
            partial)
                if [ "${GATE_ALLOW_PARTIAL:-}" = "1" ]; then
                    echo "pre-push: main ← ${local_sha:0:12}: partial gate allowed by GATE_ALLOW_PARTIAL=1"
                else
                    echo "pre-push: main ← ${local_sha:0:12}: the gate skipped a lane; re-run ./scripts/gate.sh or set GATE_ALLOW_PARTIAL=1"
                    blocked=true
                fi ;;
            *)
                echo "pre-push: main ← ${local_sha:0:12}: no gate marker; run ./scripts/gate.sh on this commit first"
                blocked=true ;;
        esac
    elif [ -z "$status" ]; then
        need_checks=true
    fi
done

if [ "$blocked" = true ]; then
    exit 1
fi
if [ "$need_checks" = false ]; then
    echo "pre-push: nothing left to check"
    exit 0
fi

# cmd/gui embeds frontend/dist (go:embed), so `go vet ./...` and
# `go test ./...` fail to compile it until the frontend is built. Build it
# once when it is missing; without npm, fall back to ./pkg/... and say so.
pkgs="./..."
dist="cmd/gui/frontend/dist"
if [ ! -d "$dist" ]; then
    if command -v npm >/dev/null 2>&1; then
        echo "pre-push: $dist missing, building the frontend..."
        (cd cmd/gui/frontend && npm ci && npm run build)
    else
        echo "pre-push: $dist missing and npm not found — checking ./pkg/... only (cmd/gui skipped)"
        pkgs="./pkg/..."
    fi
fi

echo "pre-push: checking gofmt..."
mapfile -t go_files < <(git ls-files "*.go")
unformatted=$(gofmt -s -l "${go_files[@]}")
if [ -n "$unformatted" ]; then
    echo "pre-push: these files need gofmt -s -w:"
    echo "$unformatted"
    exit 1
fi

echo "pre-push: running go vet..."
go vet "$pkgs"

echo "pre-push: running unit tests..."
go test -short "$pkgs"

echo "pre-push: all checks passed"
