#!/usr/bin/env bash
# Pre-push hook: lightweight safety net before pushing.
# Runs a gofmt check, go vet and unit tests. Blocks the push if any fails.
# Builds the GUI frontend first when cmd/gui/frontend/dist is missing.
# Skips checks for tag-only pushes (no code changed).
#
# Setup (one time):
#   git config core.hooksPath .githooks

set -e

# Git exports GIT_DIR (absolute when pushing from a linked worktree),
# GIT_WORK_TREE and friends to hooks. Every git call the test suite makes
# would then target THIS repository instead of the tests' temp repos — a
# single `git init --bare` in a test is enough to flip the main clone to
# core.bare=true. Scrub them so tests run against a clean environment.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY

# Git passes the remote ref info via stdin. If every ref being pushed
# is a tag (refs/tags/...), skip the checks — no code changed.
all_tags=true
while read local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/tags/*) ;;
        *) all_tags=false; break ;;
    esac
done

if [ "$all_tags" = true ]; then
    echo "pre-push: tag-only push, skipping checks"
    exit 0
fi

# cmd/gui embeds frontend/dist (go:embed), so `go vet ./...` and
# `go test ./...` fail to compile it until the frontend is built. Build it
# once when it is missing; without npm, fall back to ./pkg/... and say so.
pkgs="./..."
dist="cmd/gui/frontend/dist"
if [ ! -d "$dist" ]; then
    if command -v npm >/dev/null 2>&1; then
        echo "pre-push: $dist missing, building the frontend..."
        (cd cmd/gui/frontend && npm ci && npm run build)
    else
        echo "pre-push: $dist missing and npm not found — checking ./pkg/... only (cmd/gui skipped)"
        pkgs="./pkg/..."
    fi
fi

echo "pre-push: checking gofmt..."
unformatted=$(gofmt -s -l $(git ls-files '*.go'))
if [ -n "$unformatted" ]; then
    echo "pre-push: these files need gofmt -s -w:"
    echo "$unformatted"
    exit 1
fi

echo "pre-push: running go vet..."
go vet "$pkgs"

echo "pre-push: running unit tests..."
go test -short "$pkgs"

echo "pre-push: all checks passed"
